<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4A148C">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/lucky_sevens_surface"
        android:contentDescription="@string/action_toggle_menu"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/action_toggle_menu"
        app:navigationIcon="@drawable/ic_menu_toolbar"
        app:title="@string/title_lucky_sevens"
        app:titleCentered="true"
        app:titleTextColor="@color/white">

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="56dp"
            android:background="@drawable/bg_coin_badge"
            android:textColor="@color/lucky_sevens_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Coins: 125" />

    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.cardview.widget.CardView
        android:id="@+id/sideMenuCard"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="visible"
        app:cardBackgroundColor="#F3E5F5"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:padding="6dp"
            android:useDefaultMargins="true">

            <!-- SETTINGS -->
            <LinearLayout
                android:id="@+id/menuSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_settings"
                    android:textSize="20sp"
                    tools:text="⚙️" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/menu_settings"
                    android:textAlignment="center"
                    android:textColor="#4A148C"
                    android:textSize="9sp"
                    tools:text="Settings" />
            </LinearLayout>

            <!-- ONLINE -->
            <LinearLayout
                android:id="@+id/menuOnlineRanking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_online"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/menu_online"
                    android:textAlignment="center"
                    android:textColor="#4A148C"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- RANKING -->
            <LinearLayout
                android:id="@+id/menuRanking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_ranking"
                    android:textSize="20sp"
                    tools:text="⭐" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/menu_ranking"
                    android:textAlignment="center"
                    android:textColor="#4A148C"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="Ranking" />
            </LinearLayout>

            <!-- MUSIC -->
            <LinearLayout
                android:id="@+id/menuMusic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_music"
                    android:textSize="20sp"
                    tools:text="🔊" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/menu_music"
                    android:textAlignment="center"
                    android:textColor="#4A148C"
                    android:textSize="9sp"
                    tools:text="Music" />
            </LinearLayout>

            <!-- HELP -->
            <LinearLayout
                android:id="@+id/menuHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_help"
                    android:textSize="20sp"
                    tools:text="❓" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/menu_help"
                    android:textAlignment="center"
                    android:textColor="#4A148C"
                    android:textSize="9sp"
                    tools:text="Help" />
            </LinearLayout>

            <!-- LOGIN / LOGOUT -->
            <LinearLayout
                android:id="@+id/menuLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_logout"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvLogoutLabel"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/menu_logout"
                    android:textAlignment="center"
                    android:textColor="#4A148C"
                    android:textSize="9sp" />
            </LinearLayout>

        </GridLayout>

    </androidx.cardview.widget.CardView>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnPlayGame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sideMenuCard"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:layout="@layout/fragment_ranking" />

    <Button
        android:id="@+id/btnPlayGame"
        android:layout_width="200dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#7E57C2"
        android:text="@string/btn_play"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="😊 PLAY" />

</androidx.constraintlayout.widget.ConstraintLayout>